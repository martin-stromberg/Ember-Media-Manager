<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    .NET Framework 4.8 Referenzassemblys werden ueber das NuGet-Paket
    Microsoft.NETFramework.ReferenceAssemblies.net48 bereitgestellt
    (Restore: nuget restore). Dadurch ist kein installiertes
    .NET Framework 4.8 Developer Pack erforderlich.
  -->
  <PropertyGroup>
    <_Net48RefAssemblies>$(MSBuildThisFileDirectory)packages\Microsoft.NETFramework.ReferenceAssemblies.net48.1.0.3\build\.NETFramework\v4.8\</_Net48RefAssemblies>
    <FrameworkPathOverride Condition="Exists('$(_Net48RefAssemblies)')">$(_Net48RefAssemblies)</FrameworkPathOverride>
  </PropertyGroup>
</Project>
